            <br>1. {{ ('recovery.standalone_howto_step1'|trans({}, t))|replace({'%link%': '<a id="updaterStandaloneUrl" href="#" target="_blank" rel="noopener" style="color:var(--updater-text-link);font-family:monospace;">/_updater-recovery.php</a>'})|raw }}
            <br>2. {{ 'recovery.standalone_howto_step2'|trans({}, t) }}
