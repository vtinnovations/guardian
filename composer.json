{
    "name": "vtinnovations/guardian",
    "type": "contao-bundle",
    "description": "Guardian — Update, Backup & Recovery Bundle for Contao 5",
    "license": "LGPL-3.0-or-later",
    "authors": [
        {
            "name": "V&T Innovations Team"
        }
    ],
    "require": {
        "php": "^8.2",
        "ext-json": "*",
        "ext-sodium": "*",
        "contao/core-bundle": "^5.3",
        "symfony/process": "^6.4 || ^7.0",
        "symfony/console": "^6.4 || ^7.0",
        "symfony/http-client": "^6.4 || ^7.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5 || ^11.0"
    },
    "autoload-dev": {
        "psr-4": {
            "Vtinnovations\\Guardian\\Tests\\": "tests/"
        }
    },
    "autoload": {
        "psr-4": {
            "Vtinnovations\\Guardian\\": "src/"
        }
    },
    "extra": {
        "contao-manager-plugin": "Vtinnovations\\Guardian\\ContaoManager\\Plugin"
    }
}
