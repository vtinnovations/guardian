        <div id="updaterPanelTokenArea">
            <p style="font-size:.85rem;color:var(--updater-text-muted);">{{ 'recovery.token_loading'|trans({}, t) }}</p>
        </div>

        <details style="margin-top:1.2rem;">
            <summary style="cursor:pointer;font-size:.85rem;color:var(--updater-text-muted);">
                {{ 'recovery.token_env_fix_summary'|trans({}, t)|raw }}
            </summary>
            <div style="font-size:.85rem;padding:.8rem 0;line-height:1.6;color:var(--updater-text);">
                {{ 'recovery.token_env_fix_intro'|trans({}, t)|raw }}
                <pre class="updater-cron-cmd">VTINNOVATIONS_GUARDIAN_TOKEN=your-very-long-secret-token-here</pre>
                {{ 'recovery.token_env_fix_command_hint'|trans({}, t)|raw }}
                <p style="background:var(--updater-result-warn-bg);color:var(--updater-result-warn-fg);padding:.6rem .8rem;border-radius:3px;">
                    {{ 'recovery.token_env_fix_warning'|trans({}, t)|raw }}
                </p>
            </div>
        </details>
    </div>

    </div> {# end tab: recovery #}

    {# ── Upgrade dialog (shown when a Free user clicks a locked tab) ─── #}
    <div class="updater-upgrade-modal" id="updaterUpgradeModal" onclick="if(event.target===this) updaterCloseUpgradeModal()">
        <div class="box">
            <h3 id="updaterUpgradeTitle">{{ 'upgrade.title_pro'|trans({}, t) }}</h3>
            <p id="updaterUpgradeBody">
                {{ 'upgrade.body_pro_intro'|trans({}, t)|raw }}
            </p>
            <p>
                {{ 'upgrade.body_pro_unlocks'|trans({}, t)|raw }}
            </p>
            <ul style="margin:.4rem 0 .6rem 1.1rem;padding:0;color:var(--updater-text-muted);font-size:.88rem;line-height:1.6;">
                <li>{{ 'upgrade.feature_updates'|trans({}, t) }}</li>
                <li>{{ 'upgrade.feature_restore'|trans({}, t) }}</li>
                <li>{{ 'upgrade.feature_schedule'|trans({}, t) }}</li>
                <li>{{ 'upgrade.feature_panel'|trans({}, t) }}</li>
            </ul>
            <p style="font-size:.82rem;">
                {{ 'upgrade.get_license'|trans({}, t) }} <a href="https://www.v-t.one" target="_blank" rel="noopener" style="color:var(--updater-text-link);font-weight:600;">v-t.one</a>.
                {{ 'upgrade.activate_at'|trans({}, t)|raw }}
            </p>
            <div class="actions">
                <button class="updater-btn updater-btn-secondary" onclick="updaterCloseUpgradeModal()">{{ 'upgrade.close'|trans({}, t) }}</button>
                <a class="updater-btn" href="{{ settings_url }}" style="display:inline-block;text-decoration:none;">{{ 'upgrade.goto_license'|trans({}, t) }}</a>
            </div>
        </div>
    </div>
</div>

<script>
// Contao 5's Turbo replaces the entire body on a full-page render, which
// re-executes this inline <script>. Top-level `const`/`let` would throw
// "already been declared"; we use `var` for module-globals instead so a
// second execution silently overwrites without error. Function
// declarations already tolerate redeclaration.
var UPDATER_ANALYSE_URL        = '{{ path('vtinnovations_guardian_analyse') }}';
var UPDATER_PACKAGES_URL       = '{{ path('vtinnovations_guardian_packages') }}';
var UPDATER_BACKUP_CREATE_URL  = '{{ path('vtinnovations_guardian_backup_create') }}';
var UPDATER_BACKUP_LIST_URL    = '{{ path('vtinnovations_guardian_backup_list') }}';
var UPDATER_BACKUP_DELETE_URL  = '{{ path('vtinnovations_guardian_backup_delete') }}';
var UPDATER_SCHED_GET_URL      = '{{ path('vtinnovations_guardian_schedule_get') }}';
var UPDATER_SCHED_SAVE_URL     = '{{ path('vtinnovations_guardian_schedule_save') }}';
var UPDATER_SCHED_RUN_URL      = '{{ path('vtinnovations_guardian_schedule_run') }}';
var UPDATER_SCHED_TEST_EMAIL_URL = '{{ path('vtinnovations_guardian_schedule_test_email') }}';
var UPDATER_PANEL_GET_URL      = '{{ path('vtinnovations_guardian_panel_get') }}';
var UPDATER_PANEL_ROTATE_URL   = '{{ path('vtinnovations_guardian_panel_rotate') }}';
var UPDATER_JOB_START_URL      = '{{ path('vtinnovations_guardian_job_start') }}';
var UPDATER_JOB_STATUS_URL     = '{{ path('vtinnovations_guardian_job_status') }}';
var UPDATER_JOB_LOG_URL        = '{{ path('vtinnovations_guardian_job_log') }}';
var UPDATER_JOB_ARCHIVE_URL    = '{{ path('vtinnovations_guardian_job_archive') }}';
var UPDATER_JOB_CLEAR_STALE_URL = '{{ path('vtinnovations_guardian_job_clear_stale') }}';
var UPDATER_JOB_ROLLBACK_URL   = '{{ path('vtinnovations_guardian_job_rollback') }}';
var UPDATER_RUNTIME_GET_URL    = '{{ path('vtinnovations_guardian_runtime_get') }}';
var UPDATER_RUNTIME_SAVE_URL   = '{{ path('vtinnovations_guardian_runtime_save') }}';
var UPDATER_RUNTIME_TEST_URL   = '{{ path('vtinnovations_guardian_runtime_test') }}';
var UPDATER_RUNTIME_TEST_EMAIL_URL = '{{ path('vtinnovations_guardian_runtime_test_recovery_email') }}';
var UPDATER_SETTINGS_URL         = '{{ settings_url }}';
var UPDATER_BACKUPS_LIST_URL   = '{{ path('vtinnovations_guardian_backup_list') }}';

// Same per-locale strings as the server-rendered HTML above (see
// BackendController::translations()) — grouped identically so a lookup
// path like GUARDIAN_I18N.backup.confirm mirrors 'backup.confirm' in Twig.
var GUARDIAN_I18N = {{ i18n|json_encode|raw }};

var updaterPackages = [];

function updaterEscape(str) {
    const div = document.createElement('div');
    div.textContent = String(str ?? '');
    return div.innerHTML;
}

// Looks up 'section.key' in GUARDIAN_I18N and substitutes any %placeholder%
// tokens with the given values. Falls back to the key itself if missing, so
// a translation gap degrades to a visible-but-harmless label rather than a
// JS error.
function updaterT(path, params) {
    var value = path.split('.').reduce(function (obj, part) {
        return (obj && typeof obj === 'object') ? obj[part] : undefined;
    }, GUARDIAN_I18N);

    if (typeof value !== 'string') {
        return path;
    }

    if (params) {
        for (var key in params) {
            value = value.split(key).join(params[key]);
        }
    }

    return value;
}

// ── Pre-update analysis ─────────────────────────────────────────────

function updaterRunAnalysis() {
    const btn    = document.getElementById('updaterAnalyseBtn');
    const result = document.getElementById('updaterAnalysisResult');

    btn.disabled    = true;
    btn.textContent = updaterT('dashboard.analysis_running');
    result.innerHTML = '<div style="color:var(--updater-text-soft);padding:.8rem;">' + updaterEscape(updaterT('dashboard.analysis_wait')) + '</div>';

    fetch(UPDATER_ANALYSE_URL, {
        method: 'POST',
        headers: {
            'Accept': 'application/json',
            'X-Requested-With': 'XMLHttpRequest',
        },
    })
    .then(r => r.json())
    .then(data => {
        if (!data.success) {
            result.innerHTML = '<div class="updater-result-summary error">❌ '
                + updaterEscape(updaterT('msc.generic_error', {'%error%': data.error || updaterT('msc.error_generic')})) + '</div>';
            return;
        }

        const r       = data.result;
        const summary = r.summary;
        const cls     = summary.errors > 0 ? 'error' : (summary.warnings > 0 ? 'warning' : 'ok');

        let html = '<div class="updater-result-summary ' + cls + '">'
            + updaterEscape(summary.message) + '<br>'
            + '<span style="font-weight:normal;font-size:.85rem;">'
            + updaterT('dashboard.analysis_summary', {'%ok%': summary.ok, '%warnings%': summary.warnings, '%errors%': summary.errors})
            + '</span></div>';

        for (const key in r.checks) {
            const c    = r.checks[key];
            const icon = c.status === 'ok' ? '✅' : (c.status === 'warning' ? '⚠️' : '❌');
            html += '<div class="updater-check-row">'
                + '<div class="updater-check-icon">' + icon + '</div>'
                + '<div class="updater-check-body">'
                +   '<div class="updater-check-label">' + updaterEscape(c.label) + '</div>'
                +   '<div class="updater-check-message">' + updaterEscape(c.message) + '</div>'
                + '</div>'
                + '</div>';
        }

        result.innerHTML = html;
    })
    .catch(e => {
        result.innerHTML = '<div class="updater-result-summary error">❌ '
            + updaterEscape(e.message || e) + '</div>';
    })
    .finally(() => {
        btn.disabled    = false;
        btn.textContent = updaterT('dashboard.analysis_rerun');
    });
}

// ── Package overview ────────────────────────────────────────────────

function updaterLoadPackages(forceRefresh) {
    const loadBtn    = document.getElementById('updaterPkgLoadBtn');
    const refreshBtn = document.getElementById('updaterPkgRefreshBtn');
    const result     = document.getElementById('updaterPkgResult');
    const filter     = document.getElementById('updaterPkgFilter');
    const onlyLabel  = document.getElementById('updaterPkgOnlyUpdatesLabel');

    const activeBtn = forceRefresh ? refreshBtn : loadBtn;
    activeBtn.disabled    = true;
    const originalLabel   = activeBtn.textContent;
    activeBtn.textContent = forceRefresh ? updaterT('dashboard.packages_refreshing') : updaterT('dashboard.packages_loading_short');

    if (!forceRefresh) {
        result.innerHTML = '<div style="color:var(--updater-text-soft);padding:.8rem;">' + updaterEscape(updaterT('dashboard.packages_loading')) + '</div>';
    }

    const url = UPDATER_PACKAGES_URL + (forceRefresh ? '?refresh=1' : '');

    fetch(url, {
        method: 'POST',
        headers: {
            'Accept': 'application/json',
            'X-Requested-With': 'XMLHttpRequest',
        },
    })
    .then(r => r.json())
    .then(data => {
        if (!data.success) {
            result.innerHTML = '<div class="updater-result-summary error">❌ '
                + updaterEscape(data.error || updaterT('msc.error_generic')) + '</div>';
            return;
        }

        updaterPackages = data.packages;

        // Show controls now that we have data
        refreshBtn.style.display = '';
        filter.style.display     = '';
        onlyLabel.style.display  = '';

        updaterRenderPackages(data.stats);
    })
    .catch(e => {
        result.innerHTML = '<div class="updater-result-summary error">❌ '
            + updaterEscape(e.message || e) + '</div>';
    })
    .finally(() => {
        activeBtn.disabled    = false;
        activeBtn.textContent = forceRefresh ? updaterT('dashboard.packages_refresh_done') : updaterT('dashboard.packages_reload');
    });
}

function updaterRenderPackages(stats) {
    const result = document.getElementById('updaterPkgResult');
    const filter = (document.getElementById('updaterPkgFilter').value || '').toLowerCase();
    const onlyUpdates = document.getElementById('updaterPkgOnlyUpdates').checked;

    let pkgs = updaterPackages;
    if (filter) {
        pkgs = pkgs.filter(p => p.name.toLowerCase().includes(filter));
    }
    if (onlyUpdates) {
        pkgs = pkgs.filter(p => p.has_update);
    }

    let metaHtml = '';
    if (stats) {
        const cachedNote = stats.cached
            ? ' <span style="color:var(--updater-text-soft);">' + updaterEscape(updaterT('dashboard.packages_cached_note')) + '</span>'
            : '';
        const errorNote = stats.error
            ? '<div class="updater-result-summary warning">' + updaterT('dashboard.packages_check_incomplete', {'%error%': updaterEscape(stats.error)}) + '</div>'
            : '';
        metaHtml = errorNote
            + '<div class="updater-pkg-meta">'
            + updaterT('dashboard.packages_meta', {'%total%': stats.total, '%updates%': stats.updates, '%abandoned%': stats.abandoned})
            + cachedNote
            + '</div>';
    }

    if (pkgs.length === 0) {
        result.innerHTML = metaHtml
            + '<div class="updater-empty">' + updaterEscape(updaterT('dashboard.packages_no_match')) + '</div>';
        return;
    }

    const rows = pkgs.map(updaterRenderPkgRow).join('');

    result.innerHTML = metaHtml
        + '<table class="updater-pkg-table">'
        +   '<thead><tr>'
        +     '<th>' + updaterEscape(updaterT('dashboard.packages_th_package')) + '</th>'
        +     '<th style="width:120px;">' + updaterEscape(updaterT('dashboard.packages_th_current')) + '</th>'
        +     '<th style="width:160px;">' + updaterEscape(updaterT('dashboard.packages_th_available')) + '</th>'
        +     '<th style="width:140px;">' + updaterEscape(updaterT('dashboard.packages_th_status')) + '</th>'
        +   '</tr></thead>'
        +   '<tbody>' + rows + '</tbody>'
        + '</table>';
}

function updaterApplyFilter() {
    // Re-render with same stats reference (we don't have it here, so render without)
    // This is fine — the meta block will be rebuilt only on full reload
    const filter = (document.getElementById('updaterPkgFilter').value || '').toLowerCase();
    const onlyUpdates = document.getElementById('updaterPkgOnlyUpdates').checked;

    let pkgs = updaterPackages;
    if (filter) pkgs = pkgs.filter(p => p.name.toLowerCase().includes(filter));
    if (onlyUpdates) pkgs = pkgs.filter(p => p.has_update);

    const result = document.getElementById('updaterPkgResult');
    // Keep the meta line if present (preserved as the first child)
    const meta = result.querySelector('.updater-pkg-meta');
    const metaHtml = meta ? meta.outerHTML : '';

    if (pkgs.length === 0) {
        result.innerHTML = metaHtml + '<div class="updater-empty">' + updaterEscape(updaterT('dashboard.packages_no_match')) + '</div>';
        return;
    }

    const rows = pkgs.map(updaterRenderPkgRow).join('');

    result.innerHTML = metaHtml
        + '<table class="updater-pkg-table">'
        +   '<thead><tr>'
        +     '<th>' + updaterEscape(updaterT('dashboard.packages_th_package')) + '</th>'
        +     '<th style="width:120px;">' + updaterEscape(updaterT('dashboard.packages_th_current')) + '</th>'
        +     '<th style="width:160px;">' + updaterEscape(updaterT('dashboard.packages_th_available')) + '</th>'
        +     '<th style="width:140px;">' + updaterEscape(updaterT('dashboard.packages_th_status')) + '</th>'
        +   '</tr></thead>'
        +   '<tbody>' + rows + '</tbody>'
        + '</table>';
}


// ── Backup management ───────────────────────────────────────────────

function updaterCreateBackup() {
    const wantsFiles = document.getElementById('updaterBkpFiles').checked;
    let confirmMsg = updaterT('backup.confirm');
    if (wantsFiles) {
        confirmMsg += updaterT('backup.confirm_files_warning');
    }
    if (!confirm(confirmMsg)) {
        return;
    }

    const btn    = document.getElementById('updaterBackupBtn');
    const result = document.getElementById('updaterBackupResult');

    btn.disabled    = true;
    btn.innerHTML   = '<span class="updater-spinner"></span>' + updaterEscape(updaterT('backup.creating'));
    result.innerHTML = '<div style="color:var(--updater-text-soft);padding:.8rem;">' + updaterEscape(updaterT('backup.running_wait')) + '</div>';

    const components = {
        vendor:    document.getElementById('updaterBkpVendor').checked,
        templates: document.getElementById('updaterBkpTemplates').checked,
        files:     document.getElementById('updaterBkpFiles').checked,
        assets:    document.getElementById('updaterBkpAssets').checked,
    };

    fetch(UPDATER_BACKUP_CREATE_URL, {
        method: 'POST',
        headers: {
            'Accept': 'application/json',
            'Content-Type': 'application/json',
            'X-Requested-With': 'XMLHttpRequest',
        },
        body: JSON.stringify({ components: components }),
    })
    .then(r => r.json())
    .then(data => {
        if (!data.success) {
            result.innerHTML = '<div class="updater-result-summary error">❌ '
                + updaterT('backup.failed', {'%error%': updaterEscape(data.error || updaterT('msc.error_generic'))}) + '</div>';
            return;
        }

        const m = data.manifest;
        let html = '<div class="updater-result-summary ok">✅ '
            + updaterT('backup.created', {'%name%': updaterEscape(data.name), '%size%': updaterEscape(m.total_size)}) + '</div>';

        // Show component summary
        html += '<div style="margin-top:.5rem;font-size:.9rem;">';
        const renderRow = (label, info) => {
            if (!info) return '';
            const ok = info.success ? '✅' : '❌';
            return '<div>' + ok + ' ' + label + ': <code>' + updaterEscape(info.method)
                + '</code> — ' + updaterEscape(info.size) + '</div>';
        };

        html += renderRow(updaterEscape(updaterT('backup.row_database')),   m.database);
        html += renderRow(updaterEscape(updaterT('backup.row_vendor')),     m.vendor);
        html += renderRow(updaterEscape(updaterT('backup.row_templates')),  m.templates);
        html += renderRow(updaterEscape(updaterT('backup.row_contao_tpl')), m.contao_tpl);
        html += renderRow(updaterEscape(updaterT('backup.row_files')),      m.files);
        html += renderRow(updaterEscape(updaterT('backup.row_assets')),     m.assets);
        html += '</div>';

        // Show log
        if (data.log && data.log.length) {
            html += '<div class="updater-backup-log">' + data.log.map(updaterEscape).join('\n') + '</div>';
        }

        result.innerHTML = html;
        updaterReloadBackupList();
    })
    .catch(e => {
        result.innerHTML = '<div class="updater-result-summary error">❌ '
            + updaterEscape(e.message || e) + '</div>';
    })
    .finally(() => {
        btn.disabled = false;
        btn.textContent = updaterT('backup.create_more');
    });
}

function updaterDeleteBackup(name) {
    if (!confirm(updaterT('backup.delete_confirm', {'%name%': name}))) {
        return;
    }

    fetch(UPDATER_BACKUP_DELETE_URL, {
        method: 'POST',
        headers: {
            'Accept': 'application/json',
            'Content-Type': 'application/json',
            'X-Requested-With': 'XMLHttpRequest',
        },
        body: JSON.stringify({ name: name }),
    })
    .then(r => r.json())
    .then(data => {
        if (!data.success) {
            alert(updaterT('backup.delete_failed', {'%error%': data.error || updaterT('msc.error_generic')}));
            return;
        }
        updaterReloadBackupList();
    });
}

function updaterReloadBackupList() {
    const list = document.getElementById('updaterBackupList');

    fetch(UPDATER_BACKUP_LIST_URL, {
        method: 'POST',
        headers: {
            'Accept': 'application/json',
            'X-Requested-With': 'XMLHttpRequest',
        },
    })
    .then(r => r.json())
    .then(data => {
        if (!data.success || !data.backups || data.backups.length === 0) {
            list.innerHTML = '<div class="updater-empty">' + updaterEscape(updaterT('backup.empty')) + '</div>';
            return;
        }

        let html = '';
        for (const b of data.backups) {
            html += '<div class="updater-backup-row">'
                + '<div><strong>' + updaterEscape(b.name) + '</strong>'
                + '<div style="font-size:.8rem;color:var(--updater-text-soft);">Contao '
                + updaterEscape(b.contao_version) + ' · ' + updaterEscape(b.total_size) + '</div></div>'
                + '<span style="color:var(--updater-text-soft);font-size:.85rem;">' + updaterEscape(b.created_at) + '</span>'
                + '<span style="color:var(--updater-text-very-soft);font-size:.8rem;">' + updaterEscape(b.path) + '</span>'
                + '<button class="updater-btn updater-btn-delete" onclick="updaterDeleteBackup(\''
                +   updaterEscape(b.name).replace(/'/g, "\\'") + '\')">' + updaterEscape(updaterT('backup.delete')) + '</button>'
                + '</div>';
        }
        list.innerHTML = html;
    });
}


// ── Scheduled backups ───────────────────────────────────────────────

function updaterFormatDate(iso) {
    if (!iso) return '—';
    try {
        const d = new Date(iso);
        return d.toLocaleString();
    } catch (e) {
        return iso;
    }
}

function updaterToggleScheduleRows(prefix) {
    const freq = document.getElementById('sched' + prefix + 'Frequency').value;
    const isInterval = (freq === '5min' || freq === '15min' || freq === 'hourly');

    // Time-of-day only matters for daily/weekly/monthly
    const timeInput = document.getElementById('sched' + prefix + 'Time');
    if (timeInput) {
        timeInput.closest('.updater-sched-row').style.display = isInterval ? 'none' : '';
    }

    document.getElementById('sched' + prefix + 'WeekdayRow').style.display = (freq === 'weekly')  ? '' : 'none';
    document.getElementById('sched' + prefix + 'DomRow').style.display     = (freq === 'monthly') ? '' : 'none';
}

function updaterRenderScheduleState(type, info) {
    const el = document.getElementById('sched' + (type === 'mini' ? 'Mini' : 'Full') + 'State');
    if (!info) { el.innerHTML = ''; return; }

    let html = '';

    // In-progress indicator (overrides the static "last run" line)
    if (info.in_progress && info.started_at) {
        const startedTs = new Date(info.started_at).getTime();
        const elapsedSec = Math.max(0, Math.round((Date.now() - startedTs) / 1000));
        const mins = Math.floor(elapsedSec / 60);
        const secs = elapsedSec % 60;
        const elapsed = (mins > 0 ? mins + 'm ' : '') + secs + 's';
        html += '<div class="updater-sched-status warning">'
              + '<span class="updater-spinner"></span>'
              + updaterT('sched.running_since', {'%date%': updaterFormatDate(info.started_at), '%elapsed%': elapsed})
              + '</div>';
    } else if (info.last_run) {
        const cls = info.last_status === 'success' ? 'success'
                  : info.last_status === 'error'   ? 'error'
                  : 'skipped';
        html += '<div class="updater-sched-status ' + cls + '">'
              + updaterT('sched.last_run', {'%date%': updaterFormatDate(info.last_run), '%status%': updaterEscape(info.last_status || '')});
        if (info.last_message) {
            html += '<br><span style="font-weight:normal;font-size:.8rem;">' + updaterEscape(info.last_message) + '</span>';
        }
        html += '</div>';
    } else {
        html += '<div class="updater-sched-status skipped"><em>' + updaterEscape(updaterT('sched.never_ran')) + '</em></div>';
    }

    if (info.enabled && info.next_run_human) {
        html += '<div style="font-size:.8rem;color:var(--updater-text-muted);margin-top:.4rem;">'
              + updaterT('sched.next_run', {'%date%': updaterEscape(info.next_run_human)})
              + ' <span style="color:var(--updater-text-very-soft);">' + updaterEscape(updaterT('sched.next_run_approx')) + '</span>'
              + '</div>';
    }
    el.innerHTML = html;
}

function updaterLoadSchedule() {
    fetch(UPDATER_SCHED_GET_URL, {
        method: 'POST',
        headers: { 'Accept': 'application/json', 'X-Requested-With': 'XMLHttpRequest' },
    })
    .then(r => r.json())
    .then(data => {
        if (!data.success) return;

        const c = data.config;

        // Mini
        document.getElementById('schedMiniEnabled').checked     = !!c.mini.enabled;
        document.getElementById('schedMiniFrequency').value     = c.mini.frequency;
        document.getElementById('schedMiniTime').value          = c.mini.time;
        document.getElementById('schedMiniWeekday').value       = String(c.mini.weekday);
        document.getElementById('schedMiniDom').value           = c.mini.day_of_month;
        document.getElementById('schedMiniRetention').value     = c.mini.retention;

        // Full
        document.getElementById('schedFullEnabled').checked     = !!c.full.enabled;
        document.getElementById('schedFullFrequency').value     = c.full.frequency;
        document.getElementById('schedFullTime').value          = c.full.time;
        document.getElementById('schedFullWeekday').value       = String(c.full.weekday);
        document.getElementById('schedFullDom').value           = c.full.day_of_month;
        document.getElementById('schedFullRetention').value     = c.full.retention;

        document.getElementById('schedFullCompVendor').checked    = !!c.full.components.vendor;
        document.getElementById('schedFullCompTemplates').checked = !!c.full.components.templates;
        document.getElementById('schedFullCompFiles').checked     = !!c.full.components.files;
        document.getElementById('schedFullCompAssets').checked    = !!c.full.components.assets;

        // Storage + notifications
        document.getElementById('schedStoragePath').value      = c.storage_path || '';
        document.getElementById('schedEmail').value            = c.notifications.email || '';
        document.getElementById('schedSenderEmail').value      = c.notifications.sender_email || '';
        document.getElementById('schedSenderName').value       = c.notifications.sender_name || 'Guardian';
        document.getElementById('schedNotifySuccess').checked  = !!c.notifications.on_success;
        document.getElementById('schedNotifyFailure').checked  = !!c.notifications.on_failure;

        updaterToggleScheduleRows('Mini');
        updaterToggleScheduleRows('Full');

        if (data.state) {
            updaterRenderScheduleState('mini', data.state.mini);
            updaterRenderScheduleState('full', data.state.full);
        }
    });
}

function updaterCollectScheduleConfig() {
    return {
        mini: {
            enabled:      document.getElementById('schedMiniEnabled').checked,
            frequency:    document.getElementById('schedMiniFrequency').value,
            time:         document.getElementById('schedMiniTime').value,
            weekday:      parseInt(document.getElementById('schedMiniWeekday').value, 10),
            day_of_month: parseInt(document.getElementById('schedMiniDom').value, 10) || 1,
            retention:    parseInt(document.getElementById('schedMiniRetention').value, 10) || 7,
        },
        full: {
            enabled:      document.getElementById('schedFullEnabled').checked,
            frequency:    document.getElementById('schedFullFrequency').value,
            time:         document.getElementById('schedFullTime').value,
            weekday:      parseInt(document.getElementById('schedFullWeekday').value, 10),
            day_of_month: parseInt(document.getElementById('schedFullDom').value, 10) || 1,
            retention:    parseInt(document.getElementById('schedFullRetention').value, 10) || 4,
            components: {
                vendor:    document.getElementById('schedFullCompVendor').checked,
                templates: document.getElementById('schedFullCompTemplates').checked,
                files:     document.getElementById('schedFullCompFiles').checked,
                assets:    document.getElementById('schedFullCompAssets').checked,
            },
        },
        storage_path: document.getElementById('schedStoragePath').value.trim() || null,
        notifications: {
            email:        document.getElementById('schedEmail').value.trim(),
            sender_email: document.getElementById('schedSenderEmail').value.trim(),
            sender_name:  document.getElementById('schedSenderName').value.trim(),
            on_success:   document.getElementById('schedNotifySuccess').checked,
            on_failure:   document.getElementById('schedNotifyFailure').checked,
        },
    };
}

function updaterSaveSchedule() {
    const cfg    = updaterCollectScheduleConfig();
    const result = document.getElementById('schedSaveResult');
    result.textContent = updaterT('sched.saving');
    result.style.color = 'var(--updater-text-muted)';

    fetch(UPDATER_SCHED_SAVE_URL, {
        method: 'POST',
        headers: {
            'Accept': 'application/json',
            'Content-Type': 'application/json',
            'X-Requested-With': 'XMLHttpRequest',
        },
        body: JSON.stringify(cfg),
    })
    .then(r => r.json().then(data => ({ ok: r.ok, data: data })))
    .then(({ ok, data }) => {
        if (!ok || !data.success) {
            result.textContent = '❌ ' + (data.error || updaterT('sched.save_failed'));
            result.style.color = 'var(--updater-result-err-fg)';
            return;
        }

        let msg = updaterT('sched.saved');
        if (data.path_warnings && data.path_warnings.length > 0) {
            msg += ' — ⚠️ ' + data.path_warnings.join(' ');
        }
        result.textContent = msg;
        result.style.color = 'var(--updater-result-ok-fg)';

        if (data.state) {
            updaterRenderScheduleState('mini', data.state.mini);
            updaterRenderScheduleState('full', data.state.full);
        }
    })
    .catch(e => {
        result.textContent = '❌ ' + (e.message || e);
        result.style.color = 'var(--updater-result-err-fg)';
    });
}

function updaterRunSchedule(type) {
    if (!confirm(updaterT('sched.run_now_confirm', {'%type%': type}))) return;

    const stateEl = document.getElementById('sched' + (type === 'mini' ? 'Mini' : 'Full') + 'State');
    stateEl.innerHTML = '<div class="updater-sched-status skipped">' + updaterEscape(updaterT('sched.running_now')) + '</div>';

    fetch(UPDATER_SCHED_RUN_URL, {
        method: 'POST',
        headers: {
            'Accept': 'application/json',
            'Content-Type': 'application/json',
            'X-Requested-With': 'XMLHttpRequest',
        },
        body: JSON.stringify({ type: type }),
    })
    .then(r => r.json())
    .then(data => {
        if (data.state) {
            updaterRenderScheduleState('mini', data.state.mini);
            updaterRenderScheduleState('full', data.state.full);
        }
        if (data.success) {
            updaterReloadBackupList();
        }
    });
}

// ── TAB SYSTEM ────────────────────────────────────────────────────────
//
// Tabs persist via the URL hash so links can deep-link into a specific
// section and the browser back button works as expected.

var UPDATER_DEFAULT_TAB = 'dashboard';
var UPDATER_VALID_TABS  = ['dashboard', 'update', 'backup', 'recovery', 'settings'];

// License state. Three tiers:
//   - no license  → only Dashboard + Settings usable
//   - Free        → adds Backup (manual)
//   - Pro         → adds Update + Recovery + scheduled backups + panel token
//
// Server-seeded once per page load. This drives visual gating only — every
// licensed operation is enforced again server-side, so unlocking these
// variables in a console changes what the page looks like and nothing else.
// Licence changes take effect on the next page load, after being made in
// Contao → Settings.
var UPDATER_PRO      = {{ is_pro      ? 'true' : 'false' }};
var UPDATER_LICENSED = {{ is_licensed ? 'true' : 'false' }};
var UPDATER_PRO_TABS      = ['update', 'recovery'];
var UPDATER_LICENSED_TABS = ['backup'];

function updaterApplyLicenseGating() {
    // Root classes drive all visual gating via CSS (see the top of the
    // stylesheet). Server sets both on first render to avoid FOUC; JS keeps
    // them in sync when the license state changes at runtime.
    const root = document.getElementById('updaterRoot');
    if (root) {
        root.classList.toggle('updater-not-pro',    !UPDATER_PRO);
        root.classList.toggle('updater-no-license', !UPDATER_LICENSED);
    }

    updaterRenderPlan(UPDATER_PRO, UPDATER_LICENSED);

    // Drop .active from any locked panel + bounce off a now-inaccessible tab.
    const lockedTabs = [];
    if (!UPDATER_PRO)      lockedTabs.push(...UPDATER_PRO_TABS);
    if (!UPDATER_LICENSED) lockedTabs.push(...UPDATER_LICENSED_TABS);
    lockedTabs.forEach(tab => {
        const panel = document.querySelector('.updater-tab-content[data-tab-panel="' + tab + '"]');
        if (panel) panel.classList.remove('active');
    });
    const active = document.querySelector('.updater-tab-btn.active');
    if (active && lockedTabs.includes(active.dataset.tab)) {
        document.querySelectorAll('.updater-tab-btn').forEach(b => b.classList.toggle('active', b.dataset.tab === UPDATER_DEFAULT_TAB));
        document.querySelectorAll('.updater-tab-content').forEach(p => p.classList.toggle('active', p.dataset.tabPanel === UPDATER_DEFAULT_TAB));
    }
}

function updaterRenderPlan(pro, licensed) {
    const badge   = document.getElementById('updaterPlanBadge');
    const tagline = document.getElementById('updaterPlanTagline');
    const list    = document.getElementById('updaterPlanFeatures');
    if (!badge || !tagline || !list) return;

    let cls, label, msg;
    if (pro) {
        cls   = 'pro';
        label = updaterT('dashboard.plan_badge_pro');
        msg   = updaterT('dashboard.plan_tagline_pro');
    } else if (licensed) {
        cls   = 'free';
        label = updaterT('dashboard.plan_badge_free');
        msg   = updaterT('dashboard.plan_tagline_free');
    } else {
        cls   = 'none';
        label = updaterT('dashboard.plan_badge_none');
        msg   = updaterT('dashboard.plan_tagline_none');
    }
    badge.className   = 'updater-plan-badge ' + cls;
    badge.textContent = label;
    tagline.innerHTML = msg;

    const rows = [
        [updaterT('dashboard.feature_backup'),   licensed],
        [updaterT('dashboard.feature_updates'),  pro],
        [updaterT('dashboard.feature_restore'),  pro],
        [updaterT('dashboard.feature_schedule'), pro],
        [updaterT('dashboard.feature_panel'),    pro],
    ];
    list.innerHTML = rows.map(([lbl, on]) =>
        '<li class="' + (on ? 'on' : 'off') + '">' + (on ? '✓' : '🔒') + ' ' + updaterEscape(lbl) + '</li>'
    ).join('');
}

function updaterOpenUpgradeModal(tier) {
    const m     = document.getElementById('updaterUpgradeModal');
    const title = document.getElementById('updaterUpgradeTitle');
    const body  = document.getElementById('updaterUpgradeBody');
    if (!m) return;
    if (title && body) {
        if (tier === 'none') {
            title.textContent = updaterT('upgrade.title_none');
            body.innerHTML = updaterT('upgrade.body_none');
        } else {
            title.textContent = updaterT('upgrade.title_pro');
            body.innerHTML = updaterT('upgrade.body_pro_from_free');
        }
    }
    m.classList.add('open');
}

function updaterCloseUpgradeModal() {
    const m = document.getElementById('updaterUpgradeModal');
    if (m) m.classList.remove('open');
}

function updaterInitTabs() {
    const buttons = document.querySelectorAll('.updater-tab-btn');
    buttons.forEach(btn => {
        btn.addEventListener('click', () => {
            updaterSwitchTab(btn.dataset.tab, true);
        });
    });

    // Determine initial tab from URL hash, fallback to default
    const fromHash = (window.location.hash || '').replace(/^#tab=/, '');
    const initial = UPDATER_VALID_TABS.includes(fromHash) ? fromHash : UPDATER_DEFAULT_TAB;
    updaterSwitchTab(initial, false);

    // React to back/forward navigation
    window.addEventListener('hashchange', () => {
        const tab = (window.location.hash || '').replace(/^#tab=/, '');
        if (UPDATER_VALID_TABS.includes(tab)) {
            updaterSwitchTab(tab, false);
        }
    });
}

function updaterSwitchTab(name, updateHash) {
    if (!UPDATER_VALID_TABS.includes(name)) {
        name = UPDATER_DEFAULT_TAB;
    }

    // Enforce per-tab license requirement client-side (server also gates).
    if (UPDATER_PRO_TABS.includes(name) && !UPDATER_PRO) {
        updaterOpenUpgradeModal('pro');
        return;
    }
    if (UPDATER_LICENSED_TABS.includes(name) && !UPDATER_LICENSED) {
        updaterOpenUpgradeModal('none');
        return;
    }

    // Toggle button active state
    document.querySelectorAll('.updater-tab-btn').forEach(btn => {
        btn.classList.toggle('active', btn.dataset.tab === name);
    });

    // Toggle panel visibility
    document.querySelectorAll('.updater-tab-content').forEach(panel => {
        panel.classList.toggle('active', panel.dataset.tabPanel === name);
    });

    if (updateHash) {
        // Use replaceState so back-button stays useful across many tab clicks.
        // History entries get noisy fast otherwise.
        try {
            history.replaceState(null, '', '#tab=' + name);
        } catch (e) {
            window.location.hash = '#tab=' + name;
        }
    }
}

// ── RECOVERY EMAIL SETTINGS ────────────────────────────────────────

function updaterLoadRecoveryEmail() {
    fetch(UPDATER_RUNTIME_GET_URL, {
        method: 'POST',
        headers: { 'Accept': 'application/json', 'X-Requested-With': 'XMLHttpRequest' },
    })
    .then(r => r.json())
    .then(data => {
        if (data.success && data.config) {
            const recipientInput = document.getElementById('recoveryEmailInput');
            const senderInput = document.getElementById('recoverySenderInput');
            if (recipientInput) recipientInput.value = data.config.recovery_email || '';
            if (senderInput) senderInput.value = data.config.notification_sender_email || '';
        }
    });
}

function updaterSaveRecoveryEmail() {
    const recipient = (document.getElementById('recoveryEmailInput').value || '').trim();
    const sender = (document.getElementById('recoverySenderInput').value || '').trim();
    const status = document.getElementById('recoveryEmailStatus');

    if (recipient !== '' && !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(recipient)) {
        status.style.color = 'var(--updater-danger)';
        status.textContent = updaterT('settings.recipient_invalid');
        return;
    }
    if (sender !== '' && !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(sender)) {
        status.style.color = 'var(--updater-danger)';
        status.textContent = updaterT('settings.sender_invalid');
        return;
    }

    // First load current config, merge with email settings, save back.
    // We need to preserve php_binary and composer_phar — the save endpoint
    // replaces the whole config, not just the fields we send.
    fetch(UPDATER_RUNTIME_GET_URL, {
        method: 'POST',
        headers: { 'Accept': 'application/json', 'X-Requested-With': 'XMLHttpRequest' },
    })
    .then(r => r.json())
    .then(data => {
        const current = (data.success && data.config) ? data.config : {};
        const merged = Object.assign({}, current, {
            recovery_email: recipient,
            notification_sender_email: sender,
        });

        return fetch(UPDATER_RUNTIME_SAVE_URL, {
            method: 'POST',
            headers: {
                'Accept': 'application/json',
                'Content-Type': 'application/json',
                'X-Requested-With': 'XMLHttpRequest',
            },
            body: JSON.stringify(merged),
        }).then(r => r.json());
    })
    .then(data => {
        if (data.success) {
            status.style.color = 'var(--updater-success-fg)';
            status.textContent = updaterT('settings.saved_short');
            setTimeout(() => status.textContent = '', 3000);
        } else {
            status.style.color = 'var(--updater-danger)';
            status.textContent = updaterT('settings.save_failed', {'%error%': data.error || updaterT('sched.save_failed')});
        }
    })
    .catch(e => {
        status.style.color = 'var(--updater-danger)';
        status.textContent = updaterT('settings.request_failed', {'%error%': e.message || e});
    });
}

function updaterSendTestRecoveryEmail() {
    const recipient = (document.getElementById('recoveryEmailInput').value || '').trim();
    const status = document.getElementById('recoveryEmailStatus');

    if (recipient === '') {
        status.style.color = 'var(--updater-danger)';
        status.textContent = updaterT('settings.no_recipient');
        return;
    }

    status.style.color = 'var(--updater-text-muted)';
    status.textContent = updaterT('settings.sending_test');

    fetch(UPDATER_RUNTIME_TEST_EMAIL_URL, {
        method: 'POST',
        headers: {
            'Accept': 'application/json',
            'Content-Type': 'application/json',
            'X-Requested-With': 'XMLHttpRequest',
        },
        body: JSON.stringify({ recipient: recipient }),
    })
    .then(r => r.json().then(data => ({ ok: r.ok, data: data })))
    .then(({ ok, data }) => {
        if (ok && data.success) {
            status.style.color = 'var(--updater-success-fg)';
            status.textContent = updaterT('settings.test_sent', {'%recipient%': recipient});
        } else {
            status.style.color = 'var(--updater-danger)';
            const err = (data.result && data.result.error) || data.error || updaterT('msc.error_generic');
            const hint = (data.result && data.result.hint) ? updaterT('settings.test_failed_hint', {'%hint%': data.result.hint}) : '';
            status.textContent = updaterT('settings.test_failed_short');
            alert(updaterT('settings.test_failed_alert', {'%error%': err, '%hint%': hint}));
        }
    })
    .catch(e => {
        status.style.color = 'var(--updater-danger)';
        status.textContent = updaterT('settings.request_failed', {'%error%': e.message || e});
    });
}

// Contao 5 backend navigates via Hotwire Turbo — clicking a menu entry
// loads the new content into <turbo-frame id="contao-main"> without a full
// page reload, so DOMContentLoaded never fires on turbo-navigated pages.
// Bind to turbo:load and turbo:frame-load too, and guard with a flag so
// init only runs once per page instance.
function updaterBootPanel() {
    if (window.__updaterBooted) return;
    if (!document.getElementById('updaterTabs')) return; // not on our page
    window.__updaterBooted = true;
    updaterInitTabs();
    updaterLoadSchedule();
    updaterLoadPanelConfig();
    updaterLoadJobArchive();
    updaterLoadRuntime();
    updaterLoadRecoveryEmail();
    updaterSetStandaloneUrl();
    // Resume polling if a job is already running. If it's stale, render it
    // immediately so the Clear button appears without waiting for polling to start.
    fetch(UPDATER_JOB_STATUS_URL, {
        method: 'POST',
        headers: { 'Accept': 'application/json', 'X-Requested-With': 'XMLHttpRequest' },
    })
    .then(r => r.json())
    .then(data => {
        if (data.success && data.job && (data.job.status === 'queued' || data.job.status === 'running')) {
            // Render once immediately so the user sees current state (incl. stale warning if any)
            updaterRenderJob(data.job, data.is_stale, data.stale_reason);
            updaterJobLogOffset = 0;
            // Only keep polling if the job isn't already stale (no point polling a dead job)
            if (!data.is_stale) {
                updaterStartPolling();
            }
        }
    });
    document.getElementById('schedMiniFrequency').addEventListener('change', () => updaterToggleScheduleRows('Mini'));
    document.getElementById('schedFullFrequency').addEventListener('change', () => updaterToggleScheduleRows('Full'));

    const filesBox = document.getElementById('schedFullCompFiles');
    const filesWarn = document.getElementById('schedFilesWarning');
    const updateWarn = () => filesWarn.style.display = filesBox.checked ? '' : 'none';
    filesBox.addEventListener('change', updateWarn);
    updateWarn();

    // Auto-refresh schedule state every 10 seconds while a backup is in progress.
    // The in-progress markup always includes the spinner element, so checking
    // for that (rather than matching translated status text) works regardless
    // of the active locale.
    setInterval(function() {
        const miniRunning = !!document.querySelector('#schedMiniState .updater-spinner');
        const fullRunning = !!document.querySelector('#schedFullState .updater-spinner');
        if (miniRunning || fullRunning) {
            updaterLoadSchedule();
        }
    }, 10000);
}

// Fire on all three events so a first full load, a Turbo full-page visit and
// a Turbo frame swap all boot the panel. The idempotency guard inside
// updaterBootPanel() prevents double-init when several events fire.
document.addEventListener('DOMContentLoaded', updaterBootPanel);
document.addEventListener('turbo:load', updaterBootPanel);
document.addEventListener('turbo:frame-load', updaterBootPanel);
document.addEventListener('turbo:render', updaterBootPanel);

// If the content is already in the DOM at script-execution time (Turbo swap
// happens before script parse), boot immediately.
if (document.readyState !== 'loading') {
    updaterBootPanel();
}

// Reset the boot flag whenever Turbo is about to replace the frame so the next
// visit reboots cleanly. Without this, hitting Guardian → another page → TC
// Failsafe would fail to init because the guard is still set.
document.addEventListener('turbo:before-frame-render', () => { window.__updaterBooted = false; });
document.addEventListener('turbo:before-render', () => { window.__updaterBooted = false; });


// ── Job runner ──────────────────────────────────────────────────────

var updaterJobLogOffset = 0;
var updaterJobPollTimer = null;

function updaterStartRollback(failedJobId) {
    const confirmed = confirm(updaterT('job.rollback_confirm'));
    if (!confirmed) return;

    fetch(UPDATER_JOB_ROLLBACK_URL, {
        method: 'POST',
        headers: {
            'Accept': 'application/json',
            'Content-Type': 'application/json',
            'X-Requested-With': 'XMLHttpRequest',
        },
        body: JSON.stringify({ job_id: failedJobId }),
    })
    .then(r => r.json().then(data => ({ ok: r.ok, data: data })))
    .then(({ ok, data }) => {
        if (ok && data.success) {
            alert(updaterT('job.rollback_started'));
            updaterJobLogOffset = 0;
            updaterStartPolling();
        } else {
            alert(updaterT('job.rollback_failed', {'%error%': data.error || updaterT('msc.error_generic')}));
        }
    })
    .catch(e => alert(updaterT('job.rollback_request_failed', {'%error%': e.message || e})));
}

// ── REAL UPDATE MODAL ────────────────────────────────────────────────────
function updaterOpenUpdateModal() {
    const modal = document.getElementById('updaterUpdateModal');

    // The Contao backend wraps everything in a container that may have its own
    // stacking-context (transforms, filters, contain). A child with
    // `position: fixed` then sticks to THAT container instead of the viewport,
    // causing the modal to render INLINE rather than overlaying the page.
    // Re-parenting the modal to <body> escapes the trap.
    if (modal.parentElement !== document.body) {
        document.body.appendChild(modal);
    }

    modal.style.display = 'flex';

    // Also lock body scroll while the modal is open
    document.body.style.overflow = 'hidden';

    // Reset radios + checkbox to defaults
    document.querySelector('input[name="updateMode"][value="full"]').checked = true;
    document.getElementById('updaterSnapshotVendor').checked = true;
    document.getElementById('updaterSelectivePackages').style.display = 'none';

    // Bind radio change handler (idempotent — fine to re-bind)
    document.querySelectorAll('input[name="updateMode"]').forEach(r => {
        r.onchange = updaterOnUpdateModeChange;
    });
}

function updaterCloseUpdateModal() {
    document.getElementById('updaterUpdateModal').style.display = 'none';
    document.body.style.overflow = '';
}

function updaterOnUpdateModeChange() {
    const mode = document.querySelector('input[name="updateMode"]:checked').value;
    const selectiveBox = document.getElementById('updaterSelectivePackages');
    if (mode === 'selective') {
        selectiveBox.style.display = '';
        updaterLoadPackagesForSelection();
    } else {
        selectiveBox.style.display = 'none';
    }
}

function updaterLoadPackagesForSelection() {
    const box = document.getElementById('updaterSelectivePackages');
    box.innerHTML = '<div style="text-align:center;color:var(--updater-text-muted);padding:1rem;">' + updaterEscape(updaterT('update.packages_loading')) + '</div>';

    fetch(UPDATER_PACKAGES_URL, {
        method: 'POST',
        headers: {
            'Accept': 'application/json',
            'Content-Type': 'application/json',
            'X-Requested-With': 'XMLHttpRequest',
        },
    })
    .then(r => r.json())
    .then(data => {
        if (!data.success) {
            box.innerHTML = '<div style="color:var(--updater-danger);padding:.5rem;">' + updaterT('update.load_error', {'%error%': updaterEscape(data.error || updaterT('msc.error_generic'))}) + '</div>';
            return;
        }

        const withUpdates = (data.packages || []).filter(p => p.has_update);
        if (withUpdates.length === 0) {
            box.innerHTML = '<div style="color:var(--updater-text-muted);padding:1rem;text-align:center;">'
                          + updaterEscape(updaterT('update.packages_all_current')) + '</div>';
            return;
        }

        let html = '<div style="padding:.4rem;font-size:.8rem;color:var(--updater-text-muted);">'
                 + updaterEscape(updaterT('update.packages_updates_available', {'%count%': withUpdates.length})) + '</div>'
                 + '<div style="padding:.3rem;display:flex;gap:.4rem;">'
                 + '<button class="updater-btn updater-btn-secondary" onclick="updaterSelectAllPkgs(true)" style="font-size:.75rem;padding:.25rem .6rem;">' + updaterEscape(updaterT('update.select_all')) + '</button>'
                 + '<button class="updater-btn updater-btn-secondary" onclick="updaterSelectAllPkgs(false)" style="font-size:.75rem;padding:.25rem .6rem;">' + updaterEscape(updaterT('update.deselect_all')) + '</button>'
                 + '</div>';

        for (const p of withUpdates) {
            html += '<label class="updater-pkg-row">'
                  + '<input type="checkbox" class="updater-pkg-checkbox" value="' + updaterEscape(p.name) + '">'
                  + '<span class="pkg-name">' + updaterEscape(p.name) + '</span>'
                  + '<span class="pkg-version">' + updaterEscape(p.current) + '</span>'
                  + '<span class="pkg-arrow">→</span>'
                  + '<span class="pkg-version">' + updaterEscape(p.latest || '?') + '</span>'
                  + '</label>';
        }

        box.innerHTML = html;
    })
    .catch(e => {
        box.innerHTML = '<div style="color:var(--updater-danger);padding:.5rem;">' + updaterT('update.load_error', {'%error%': updaterEscape(e.message || e)}) + '</div>';
    });
}

function updaterSelectAllPkgs(value) {
    document.querySelectorAll('.updater-pkg-checkbox').forEach(cb => { cb.checked = value; });
}

function updaterConfirmStartUpdate() {
    const mode = document.querySelector('input[name="updateMode"]:checked').value;
    const snapshotVendor = document.getElementById('updaterSnapshotVendor').checked;
    const sendEmail = document.getElementById('updaterSendRecoveryEmail').checked;

    const options = {
        update_mode: mode,
        snapshot_vendor: snapshotVendor,
        send_recovery_email: sendEmail,
    };

    if (mode === 'selective') {
        const selected = Array.from(document.querySelectorAll('.updater-pkg-checkbox:checked'))
            .map(cb => cb.value);
        if (selected.length === 0) {
            alert(updaterT('update.select_at_least_one'));
            return;
        }
        options.packages = selected;
    }

    const modeLabels = {
        full:      updaterT('update.mode_label_full'),
        patch:     updaterT('update.mode_label_patch'),
        selective: updaterT('update.mode_label_selective', {'%count%': options.packages ? options.packages.length : 0}),
    };

    const snapshotNote = snapshotVendor
        ? updaterT('update.snapshot_note_with_vendor')
        : updaterT('update.snapshot_note_without_vendor');

    const confirmed = confirm(updaterT('update.real_confirm', {'%mode%': modeLabels[mode], '%snapshot_note%': snapshotNote}));
    if (!confirmed) return;

    updaterCloseUpdateModal();
    updaterStartJob('update', options);
}

function updaterStartJob(type, options) {
    options = options || {};
    const isDryRun = (type === 'dry_run');
    // For dry-run keep the legacy confirm dialog; real-update has already
    // confirmed via the modal.
    if (isDryRun) {
        if (!confirm(updaterT('update.dry_run_confirm'))) return;
    }

    fetch(UPDATER_JOB_START_URL, {
        method: 'POST',
        headers: {
            'Accept': 'application/json',
            'Content-Type': 'application/json',
            'X-Requested-With': 'XMLHttpRequest',
        },
        body: JSON.stringify({ type: type, options: options }),
    })
    .then(r => r.json().then(data => ({ ok: r.ok, status: r.status, data: data })))
    .then(({ ok, status, data }) => {
        if (ok && data.success) {
            updaterJobLogOffset = 0;
            updaterStartPolling();
            return;
        }

        const reason = data.reason || '';

        if (reason === 'worker_spawn_failed') {
            // Show a specific dialog rather than a generic "failed" alert
            alert(
                updaterT('update.worker_failed_title') + '\n\n' +
                (data.error || '') + '\n\n' +
                updaterT('update.worker_failed_hint')
            );
            // Reload the active job state so the failed job shows in the UI
            updaterJobLogOffset = 0;
            updaterStartPolling();
            return;
        }

        if (reason === 'email_failed') {
            // The recovery email couldn't be sent. We refuse to start the
            // update — the user opted in to receive the email and we don't
            // want them thinking they're protected when they're not.
            const hint = data.hint ? updaterT('update.email_failed_hint', {'%hint%': data.hint}) : '';
            alert(
                updaterT('update.email_failed_title') + '\n\n' +
                (data.error || '') + hint + '\n\n' +
                updaterT('update.email_failed_body')
            );
            return;
        }

        if (reason === 'blocked') {
            alert(
                updaterT('update.blocked_title') + '\n\n' +
                (data.error || updaterT('msc.error_generic')) + '\n\n' +
                updaterT('update.blocked_hint')
            );
            updaterJobLogOffset = 0;
            updaterStartPolling();
            return;
        }

        alert(updaterT('update.job_start_failed', {'%error%': data.error || updaterT('msc.error_generic')}));
    })
    .catch(e => alert(updaterT('msc.generic_error', {'%error%': e.message || e})));
}

function updaterStartPolling() {
    updaterLastSeenJob = null;
    if (updaterJobPollTimer) clearInterval(updaterJobPollTimer);
    updaterPollJob();
    updaterJobPollTimer = setInterval(updaterPollJob, 2000);
}

function updaterStopPolling() {
    if (updaterJobPollTimer) clearInterval(updaterJobPollTimer);
    updaterJobPollTimer = null;
}

// Tracks the most recently-seen job so we can finalise the UI even after
// the job is archived (job.json removed → /api/job returns null).
var updaterLastSeenJob = null;

function updaterPollJob() {
    fetch(UPDATER_JOB_STATUS_URL, {
        method: 'POST',
        headers: { 'Accept': 'application/json', 'X-Requested-With': 'XMLHttpRequest' },
    })
    .then(r => r.json())
    .then(data => {
        if (!data.success) return;

        if (data.job) {
            updaterLastSeenJob = data.job;
            updaterRenderJob(data.job, data.is_stale, data.stale_reason);
        } else if (updaterLastSeenJob !== null
                   && (updaterLastSeenJob.status === 'running' || updaterLastSeenJob.status === 'queued')) {
            // Job vanished while we were tracking it as in-progress.
            // Synthesise a 'succeeded' final state so the UI displays all
            // steps as done rather than leaving the last step stuck on 'running'.
            const finalJob = {
                ...updaterLastSeenJob,
                status: 'succeeded',
                current_step: null,
                finished_at: new Date().toISOString(),
            };
            updaterRenderJob(finalJob, false, '');
            updaterStopPolling();
            updaterLoadJobArchive();
        } else {
            updaterRenderJob(data.job, data.is_stale, data.stale_reason);
        }
    });

    fetch(UPDATER_JOB_LOG_URL, {
        method: 'POST',
        headers: {
            'Accept': 'application/json',
            'Content-Type': 'application/json',
            'X-Requested-With': 'XMLHttpRequest',
        },
        body: JSON.stringify({ offset: updaterJobLogOffset }),
    })
    .then(r => r.json())
    .then(data => {
        if (!data.success) return;
        updaterAppendLog(data.entries);
        updaterJobLogOffset = data.offset;
    });
}

function updaterRenderJob(job, isStale, staleReason) {
    const wrap = document.getElementById('updaterJobActive');

    if (!job) {
        // No active job — but we may still be displaying a finished one.
        // Stop polling once we get a "no job" response and the visible block isn't running.
        if (wrap.querySelector('.updater-job-step.running')) return;
        // If user has nothing on screen yet, hide the area.
        if (wrap.innerHTML.trim() === '') wrap.style.display = 'none';
        return;
    }

    wrap.style.display = '';

    const statusBadgeClass = job.status === 'succeeded' ? 'updater-status-success'
                           : job.status === 'failed'    ? 'updater-status-error'
                           : job.status === 'cancelled' ? 'updater-status-error'
                           : 'updater-status-running';

    let html = '<div class="updater-job-card">'
        + '<div class="updater-job-status">'
        + '<span class="updater-status-badge ' + statusBadgeClass + '">' + updaterEscape(job.status) + '</span>'
        + '<span style="color:var(--updater-text-muted);font-size:.85rem;">'
        + updaterEscape(updaterT('job.job_label')) + ' <code>' + updaterEscape(job.id) + '</code> · ' + updaterEscape(job.type) + '</span>'
        + '</div>';

    // Step pipeline
    //
    // For failed jobs we use job.failed_step (the step that actually broke)
    // rather than job.current_step — current_step may have advanced to a
    // cleanup step like maintenance_off, which would mis-paint that step red
    // and leave the actually-broken step (e.g. cache_clear) looking like it
    // finished cleanly.
    const failureStep = (job.status === 'failed') ? (job.failed_step || job.current_step) : job.current_step;

    html += '<div class="updater-job-steps">';
    let pastCurrent = false;
    for (const stepName of job.steps) {
        let cls = 'pending';
        if (job.status === 'failed' && stepName === failureStep) {
            cls = 'failed';
            pastCurrent = false;
        } else if (stepName === job.current_step && job.status !== 'failed') {
            cls = 'running';
            pastCurrent = false;
        } else if (!pastCurrent && job.status !== 'queued') {
            // Steps before currentStep are done (or all done if no currentStep)
            if (job.current_step === null || job.steps.indexOf(stepName) < job.steps.indexOf(job.current_step)) {
                cls = 'done';
            } else {
                pastCurrent = true;
            }
        }
        if (job.status === 'succeeded') cls = 'done';

        html += '<div class="updater-job-step ' + cls + '">' + updaterEscape(stepName) + '</div>';
    }
    html += '</div>';

    // Error message if any
    if (job.error) {
        html += '<div style="background:var(--updater-result-err-bg);color:var(--updater-result-err-fg);'
              + 'padding:.7rem 1rem;border-radius:3px;margin-top:.6rem;font-family:monospace;font-size:.8rem;">'
              + updaterEscape(job.error) + '</div>';
    }

    // Auto-rollback button for failed real-update jobs that have a pre-snapshot.
    // This button is specifically for "this update I just ran failed, undo it" —
    // distinct from the general restore flow (which only lives in the Recovery
    // panels). It's an in-context shortcut, not a general restore tool.
    if (job.status === 'failed'
        && job.type === 'update'
        && job.options
        && job.options.pre_snapshot_name) {
        html += '<div style="background:var(--updater-result-warn-bg);color:var(--updater-result-warn-fg);'
              + 'padding:1rem 1.2rem;border-radius:4px;margin-top:.8rem;border:2px solid var(--updater-danger);">'
              + '<div style="font-weight:600;font-size:1rem;margin-bottom:.4rem;">'
              + updaterEscape(updaterT('job.update_failed_rollback_title'))
              + '</div>'
              + '<div style="font-size:.85rem;margin-bottom:.7rem;line-height:1.4;">'
              + updaterT('job.update_failed_rollback_body', {'%snapshot%': '<code>' + updaterEscape(job.options.pre_snapshot_name) + '</code>'})
              + '</div>'
              + '<button class="updater-btn" onclick="updaterStartRollback(\'' + updaterEscape(job.id) + '\')" '
              + 'style="background:var(--updater-danger);font-size:.95rem;padding:.6rem 1.4rem;">'
              + updaterEscape(updaterT('job.auto_rollback_button'))
              + '</button>'
              + '<div style="margin-top:.5rem;font-size:.75rem;color:var(--updater-text-muted);">'
              + updaterT('job.auto_rollback_fallback_hint')
              + '</div>'
              + '</div>';
    }

    // Stale warning + clear button
    if (isStale) {
        html += '<div style="background:var(--updater-result-warn-bg);color:var(--updater-result-warn-fg);'
              + 'padding:.7rem 1rem;border-radius:4px;margin-top:.6rem;font-size:.85rem;">'
              + updaterT('job.stale_warning', {'%reason%': updaterEscape(staleReason || '')})
              + '<div style="margin-top:.5rem;">'
              + '<button class="updater-btn" onclick="updaterClearStaleJob(false)" '
              + 'style="background:var(--updater-danger);font-size:.8rem;padding:.4rem .9rem;">'
              + updaterEscape(updaterT('job.clear_stale_button')) + '</button>'
              + '</div>'
              + '</div>';
    } else if (job.status === 'queued' || job.status === 'running') {
        // Allow forcing an abort even for fresh jobs the user knows are stuck
        html += '<div style="margin-top:.6rem;font-size:.8rem;">'
              + '<button class="updater-btn" onclick="updaterClearStaleJob(true)" '
              + 'style="background:var(--updater-danger);font-size:.75rem;padding:.3rem .7rem;">'
              + updaterEscape(updaterT('job.force_abort_button')) + '</button>'
              + '<span style="margin-left:.5rem;color:var(--updater-text-muted);">'
              + updaterEscape(updaterT('job.force_abort_hint'))
              + '</span>'
              + '</div>';
    }

    // Live log
    html += '<h4 style="margin:1rem 0 .5rem 0;font-size:.9rem;color:var(--updater-text);">' + updaterEscape(updaterT('job.live_log')) + '</h4>'
          + '<div class="updater-job-log" id="updaterJobLog"></div>';

    // Stop polling when finished
    if (job.status === 'succeeded' || job.status === 'failed' || job.status === 'cancelled') {
        html += '<div style="margin-top:.8rem;font-size:.85rem;color:var(--updater-text-muted);">'
              + updaterEscape(updaterT('job.finished_hint'))
              + '</div>';

        // Stop polling but keep one final log read in flight
        setTimeout(() => {
            updaterStopPolling();
            updaterLoadJobArchive();
        }, 1000);
    }

    html += '</div>';

    // Re-render the whole structure when:
    //   - the job ID changed (new job started)
    //   - the log container has been wiped (DOM was reset)
    //   - the status transitioned between non-terminal and terminal (controls
    //     like "Force abort" should disappear; status-specific blocks like
    //     "Auto-rollback" should appear/disappear)
    //
    // Without the status-change check we'd keep the running-job controls
    // (Force abort etc.) visible after a successful completion.
    const existingId     = wrap.dataset.jobId;
    const existingStatus = wrap.dataset.jobStatus || '';
    const statusChanged  = existingStatus !== job.status;

    if (existingId !== job.id || !document.getElementById('updaterJobLog') || statusChanged) {
        // Preserve any existing log content so a status-change re-render
        // doesn't wipe the log the user has been watching scroll by.
        const existingLog = document.getElementById('updaterJobLog');
        const preservedLogHtml = existingLog ? existingLog.innerHTML : '';

        wrap.innerHTML = html;
        wrap.dataset.jobId     = job.id;
        wrap.dataset.jobStatus = job.status;

        if (preservedLogHtml !== '') {
            const newLog = document.getElementById('updaterJobLog');
            if (newLog) {
                newLog.innerHTML = preservedLogHtml;
                newLog.scrollTop = newLog.scrollHeight;
            }
        }
    } else {
        // Cheap update path: same job, same status, just refresh step states
        const badge = wrap.querySelector('.updater-status-badge');
        if (badge) {
            badge.className = 'updater-status-badge ' + statusBadgeClass;
            badge.textContent = job.status;
        }
        // Update step states
        const stepEls = wrap.querySelectorAll('.updater-job-step');
        let i = 0;
        for (const stepName of job.steps) {
            if (stepEls[i]) {
                let cls = 'pending';
                if (stepName === job.current_step) {
                    cls = job.status === 'failed' ? 'failed' : 'running';
                } else if (job.current_step === null && job.status === 'succeeded') {
                    cls = 'done';
                } else if (job.current_step !== null && job.steps.indexOf(stepName) < job.steps.indexOf(job.current_step)) {
                    cls = 'done';
                }
                stepEls[i].className = 'updater-job-step ' + cls;
            }
            i++;
        }
    }
}

// ── Runtime config (PHP CLI binary) ─────────────────────────────────

function updaterLoadRuntime() {
    fetch(UPDATER_RUNTIME_GET_URL, {
        method: 'POST',
        headers: { 'Accept': 'application/json', 'X-Requested-With': 'XMLHttpRequest' },
    })
    .then(r => r.json())
    .then(data => {
        if (!data.success) return;

        // Licence state is rendered server-side in Contao → Settings and is
        // not part of the runtime config payload.

        document.getElementById('runtimePhpBinary').value = data.config.php_binary || '';
        const rf = document.getElementById('runtimeRecoveryPanelFilename');
        if (rf) rf.value = data.config.recovery_panel_filename || '_updater-recovery.php';

        // Render candidate suggestions
        const candsDiv = document.getElementById('runtimeCandidates');
        const cands = data.candidates || {};
        const paths = Object.keys(cands);
        if (paths.length === 0) {
            candsDiv.innerHTML = '<span style="color:var(--updater-text-muted);">' + updaterEscape(updaterT('settings.php_no_candidates')) + '</span>';
            return;
        }
        let html = '<span style="color:var(--updater-text-muted);">' + updaterEscape(updaterT('settings.php_suggestions')) + '</span>';
        for (const p of paths) {
            html += '<a href="#" onclick="document.getElementById(\'runtimePhpBinary\').value=\'' + updaterEscape(p) + '\';return false;" '
                  + 'style="color:var(--updater-text-link);text-decoration:none;margin-right:.8rem;display:inline-block;font-family:monospace;font-size:.75rem;">'
                  + updaterEscape(p) + '</a>';
        }
        candsDiv.innerHTML = html;
    });
}

function updaterTestPhpBinary() {
    const path = document.getElementById('runtimePhpBinary').value.trim();
    const result = document.getElementById('runtimeResult');
    result.textContent = updaterT('settings.php_testing');
    result.style.color = 'var(--updater-text-muted)';

    fetch(UPDATER_RUNTIME_TEST_URL, {
        method: 'POST',
        headers: { 'Accept': 'application/json', 'Content-Type': 'application/json', 'X-Requested-With': 'XMLHttpRequest' },
        body: JSON.stringify({ php_binary: path }),
    })
    .then(r => r.json())
    .then(data => {
        const r = data.result || {};
        if (r.ok) {
            result.textContent = '✅ ' + r.version;
            result.style.color = 'var(--updater-result-ok-fg)';
        } else {
            result.textContent = '❌ ' + (r.error || updaterT('settings.php_test_failed'));
            result.style.color = 'var(--updater-result-err-fg)';
        }
    });
}

function updaterSaveRuntime() {
    const path = document.getElementById('runtimePhpBinary').value.trim();
    const result = document.getElementById('runtimeResult');
    result.textContent = updaterT('settings.php_saving');
    result.style.color = 'var(--updater-text-muted)';

    fetch(UPDATER_RUNTIME_SAVE_URL, {
        method: 'POST',
        headers: { 'Accept': 'application/json', 'Content-Type': 'application/json', 'X-Requested-With': 'XMLHttpRequest' },
        body: JSON.stringify({ php_binary: path }),
    })
    .then(r => r.json().then(d => ({ ok: r.ok, data: d })))
    .then(({ ok, data }) => {
        if (ok && data.success) {
            result.textContent = updaterT('settings.php_saved');
            result.style.color = 'var(--updater-result-ok-fg)';
        } else {
            result.textContent = updaterT('settings.php_save_failed', {'%error%': data.error || updaterT('sched.save_failed')});
            result.style.color = 'var(--updater-result-err-fg)';
        }
    });
}

function updaterSaveRecoveryPanelFilename() {
    const input  = document.getElementById('runtimeRecoveryPanelFilename');
    const result = document.getElementById('runtimeRecoveryPanelResult');
    const raw    = (input.value || '').trim();

    if (raw !== '' && !/^[A-Za-z0-9._-]{1,60}\.php$/.test(raw)) {
        result.textContent = updaterT('recovery.filename_invalid');
        result.style.color = 'var(--updater-result-err-fg)';
        return;
    }

    result.textContent = updaterT('recovery.filename_saving');
    result.style.color = 'var(--updater-text-muted)';

    fetch(UPDATER_RUNTIME_SAVE_URL, {
        method: 'POST',
        headers: { 'Accept': 'application/json', 'Content-Type': 'application/json', 'X-Requested-With': 'XMLHttpRequest' },
        body: JSON.stringify({ recovery_panel_filename: raw }),
    })
    .then(r => r.json())
    .then(data => {
        if (data.success) {
            const stored = (data.config && data.config.recovery_panel_filename) || '_updater-recovery.php';
            input.value = stored;
            updaterSetStandaloneUrl(stored);
            result.textContent = updaterT('recovery.filename_saved', {'%filename%': stored});
            result.style.color = 'var(--updater-result-ok-fg)';
        } else {
            result.textContent = updaterT('recovery.filename_save_failed', {'%error%': data.error || updaterT('sched.save_failed')});
            result.style.color = 'var(--updater-result-err-fg)';
        }
    })
    .catch(e => {
        result.textContent = updaterT('recovery.filename_request_failed', {'%error%': e.message || e});
        result.style.color = 'var(--updater-result-err-fg)';
    });
}

function updaterClearStaleJob(force) {
    const isForce = !!force;
    const msg = isForce
        ? updaterT('job.clear_stale_confirm_force')
        : updaterT('job.clear_stale_confirm');

    if (!confirm(msg)) {
        return;
    }

    fetch(UPDATER_JOB_CLEAR_STALE_URL, {
        method: 'POST',
        headers: { 'Accept': 'application/json', 'Content-Type': 'application/json', 'X-Requested-With': 'XMLHttpRequest' },
        body: JSON.stringify({ force: isForce }),
    })
    .then(r => r.json())
    .then(data => {
        if (data.success) {
            // Hide the job area and stop polling
            const wrap = document.getElementById('updaterJobActive');
            wrap.innerHTML = '';
            wrap.style.display = 'none';
            updaterStopPolling();
            updaterLoadJobArchive();
        } else {
            alert(updaterT('job.clear_stale_failed', {'%error%': data.error || updaterT('msc.error_generic')}));
        }
    })
    .catch(e => alert(updaterT('job.clear_stale_request_failed', {'%error%': e.message || e})));
}

function updaterAppendLog(entries) {
    const logEl = document.getElementById('updaterJobLog');
    if (!logEl || entries.length === 0) return;

    const fragments = [];
    for (const entry of entries) {
        const time = entry.ts ? entry.ts.split('T')[1].split(/[+\-Z]/)[0] : '';
        const cls  = 'log-' + (entry.level || 'info');
        const step = entry.step ? '[' + entry.step + ']' : '';
        fragments.push(
            '<span class="log-time">' + updaterEscape(time) + '</span> ' +
            '<span class="' + cls + '">' + updaterEscape(step + ' ' + (entry.msg || '')) + '</span>'
        );
    }
    logEl.innerHTML += fragments.join('\n') + '\n';

    // Auto-scroll to bottom
    logEl.scrollTop = logEl.scrollHeight;
}

function updaterLoadJobArchive() {
    fetch(UPDATER_JOB_ARCHIVE_URL, {
        method: 'POST',
        headers: { 'Accept': 'application/json', 'X-Requested-With': 'XMLHttpRequest' },
    })
    .then(r => r.json())
    .then(data => {
        const el = document.getElementById('updaterJobArchive');
        if (!el) return;

        if (!data.success || !data.jobs || data.jobs.length === 0) {
            el.innerHTML = '<em>' + updaterEscape(updaterT('update.no_previous_jobs')) + '</em>';
            return;
        }

        let html = '';
        for (const j of data.jobs) {
            const statusClass = j.status === 'succeeded' ? 'updater-status-success'
                              : j.status === 'failed' ? 'updater-status-error'
                              : 'updater-status-idle';
            html += '<div class="updater-job-archive-row">'
                  + '<span class="updater-status-badge ' + statusClass + '" style="font-size:.7rem;padding:.15rem .5rem;">'
                  + updaterEscape(j.status) + '</span>'
                  + '<code style="font-size:.75rem;">' + updaterEscape(j.id) + '</code>'
                  + '<span style="font-size:.75rem;">' + updaterEscape(j.type) + '</span>'
                  + '<span style="color:var(--updater-text-muted);font-size:.75rem;">'
                  + updaterEscape(j.finished_at || j.created_at) + '</span>';
            if (j.error) {
                html += '<span style="color:var(--updater-result-err-fg);font-size:.75rem;flex:1;">' + updaterEscape(j.error) + '</span>';
            }
            html += '</div>';
        }
        el.innerHTML = html;
    });
}

function updaterTestEmail() {
    const result = document.getElementById('updaterTestEmailResult');
    result.innerHTML = '<div style="color:var(--updater-text-muted);font-size:.8rem;">' + updaterEscape(updaterT('sched.test_email_sending')) + '</div>';

    // Save config first so the test uses the latest settings
    const cfg = updaterCollectScheduleConfig();
    fetch(UPDATER_SCHED_SAVE_URL, {
        method: 'POST',
        headers: { 'Accept': 'application/json', 'Content-Type': 'application/json', 'X-Requested-With': 'XMLHttpRequest' },
        body: JSON.stringify(cfg),
    })
    .then(r => r.json())
    .then(saveData => {
        if (!saveData.success) {
            result.innerHTML = '<div class="updater-result-summary error">❌ ' + updaterT('sched.test_email_save_failed', {'%error%': updaterEscape(saveData.error || updaterT('msc.error_generic'))}) + '</div>';
            return;
        }

        // Now send the test
        return fetch(UPDATER_SCHED_TEST_EMAIL_URL, {
            method: 'POST',
            headers: { 'Accept': 'application/json', 'X-Requested-With': 'XMLHttpRequest' },
        });
    })
    .then(r => r ? r.json() : null)
    .then(data => {
        if (!data) return;
        const r = data.result || {};
        if (data.success) {
            result.innerHTML =
                '<div class="updater-result-summary ok">' + updaterEscape(updaterT('sched.test_email_sent')) + '<br>'
              + '<span style="font-size:.8rem;font-weight:normal;">' + updaterT('sched.test_email_sender_used', {'%sender%': '<code>' + updaterEscape(r.sender_used || '?') + '</code>'}) + '</span><br>'
              + '<span style="font-size:.8rem;font-weight:normal;">' + updaterT('sched.test_email_check_inbox', {'%recipient%': '<code>' + updaterEscape(r.recipient || '?') + '</code>'}) + '</span>'
              + '</div>';
        } else {
            let html = '<div class="updater-result-summary error">' + updaterEscape(updaterT('sched.test_email_failed')) + '<br>'
                     + '<span style="font-size:.8rem;font-weight:normal;font-family:monospace;">' + updaterEscape(r.error || updaterT('msc.error_generic')) + '</span>';
            if (r.hint) {
                html += '<div style="background:var(--updater-result-warn-bg);color:var(--updater-result-warn-fg);padding:.5rem .7rem;border-radius:3px;margin-top:.5rem;font-size:.8rem;font-weight:normal;line-height:1.5;">'
                     + '💡 ' + updaterEscape(r.hint) + '</div>';
            }
            if (r.sender_attempted) {
                html += '<div style="font-size:.75rem;font-weight:normal;margin-top:.4rem;">' + updaterT('sched.test_email_sender_attempted', {'%sender%': '<code>' + updaterEscape(r.sender_attempted) + '</code>'}) + '</div>';
            }
            html += '</div>';
            result.innerHTML = html;
        }
    })
    .catch(e => {
        result.innerHTML = '<div class="updater-result-summary error">❌ ' + updaterEscape(e.message || e) + '</div>';
    });
}

// ── Recovery Panel ──────────────────────────────────────────────────

function updaterSetStandaloneUrl(customFilename) {
    // Server (panel/get) is the authority on the filename; fall back to the
    // default only if we don't have it yet.
    const el = document.getElementById('updaterStandaloneUrl');
    if (!el) return;
    const filename = customFilename || '_updater-recovery.php';
    const url = window.location.protocol + '//' + window.location.host + '/' + filename;
    el.textContent = url;
    el.href = url;
}

function updaterLoadPanelConfig() {
    fetch(UPDATER_PANEL_GET_URL, {
        method: 'POST',
        headers: { 'Accept': 'application/json', 'X-Requested-With': 'XMLHttpRequest' },
    })
    .then(r => r.json())
    .then(data => {
        if (!data.success) return;

        // Token display
        renderPanelToken(data);

        // Sync the standalone URL with the admin-configured filename.
        if (data.panel_url) {
            try {
                const u = new URL(data.panel_url);
                const fn = u.pathname.replace(/^\//, '');
                updaterSetStandaloneUrl(fn);
            } catch (e) { /* keep default */ }
        }
    });
}

function renderPanelToken(data) {
    const tokenArea = document.getElementById('updaterPanelTokenArea');
    const sourceLabel = data.token_source === 'env'
        ? '<span class="updater-token-source-badge updater-token-source-env">' + updaterEscape(updaterT('recovery.token_source_env')) + '</span>'
        : '<span class="updater-token-source-badge updater-token-source-file">' + updaterEscape(updaterT('recovery.token_source_generated')) + '</span>';

    // SECURITY: only the masked preview is returned by /panel/get. The full
    // token is only returned by /panel/rotate. To prevent users from being
    // locked out, we let them rotate to obtain a fresh token (the old one is
    // invalidated atomically).
    const tokenPreview = data.token_preview || '****';

    let html = '<div style="margin-bottom:.4rem;font-size:.85rem;">'
             + updaterT('recovery.token_source_label', {'%badge%': sourceLabel}) + '</div>'
             + '<div class="updater-token-display" id="panelTokenValue" data-masked="true">'
             +   updaterEscape(tokenPreview)
             + '</div>'
             + '<div style="display:flex;gap:.5rem;flex-wrap:wrap;margin-top:.5rem;">';

    if (data.token_source !== 'env') {
        html += '<button class="updater-btn updater-btn-secondary" onclick="updaterRotatePanelToken()" style="font-size:.8rem;padding:.4rem .8rem;background:var(--updater-danger);">' + updaterEscape(updaterT('recovery.token_rotate_button')) + '</button>';
    }
    html += '</div>';

    if (data.token_source === 'env') {
        html += '<div style="font-size:.8rem;color:var(--updater-text-muted);margin-top:.5rem;">'
              + updaterT('recovery.token_env_note')
              + '</div>';
    } else {
        html += '<div style="font-size:.8rem;color:var(--updater-text-muted);margin-top:.5rem;">'
              + updaterT('recovery.token_file_note')
              + '</div>';
    }

    tokenArea.innerHTML = html;
}

function updaterCopyPanelToken() {
    const el = document.getElementById('panelTokenValue');
    const token = el.textContent;
    if (el.dataset.masked === 'true') {
        alert(updaterT('recovery.token_masked_alert'));
        return;
    }
    navigator.clipboard.writeText(token).then(() => {
        const btn = event.target;
        const original = btn.textContent;
        btn.textContent = updaterT('recovery.token_copied');
        setTimeout(() => { btn.textContent = original; }, 1500);
    });
}

function updaterRotatePanelToken() {
    if (!confirm(updaterT('recovery.token_rotate_confirm'))) {
        return;
    }

    fetch(UPDATER_PANEL_ROTATE_URL, {
        method: 'POST',
        headers: { 'Accept': 'application/json', 'X-Requested-With': 'XMLHttpRequest' },
    })
    .then(r => r.json())
    .then(data => {
        if (!data.success) {
            alert(data.error || updaterT('recovery.token_rotate_failed'));
            return;
        }

        // Show the new token ONCE — replace the token area with a reveal block
        // that has copy + dismiss buttons. After dismissal we reload the masked
        // view so the full token isn't lingering in the DOM.
        const tokenArea = document.getElementById('updaterPanelTokenArea');
        const fullToken = data.token || '';

        tokenArea.innerHTML =
            '<div style="background:var(--updater-result-warn-bg);color:var(--updater-result-warn-fg);'
          + 'padding:.8rem 1rem;border-radius:4px;margin-bottom:.6rem;font-size:.85rem;line-height:1.4;">'
          + '<strong>' + updaterEscape(updaterT('recovery.token_new_warning_title')) + '</strong><br>'
          + updaterT('recovery.token_new_warning_body')
          + '</div>'
          + '<div class="updater-token-display" id="panelTokenValueFull" '
          + 'style="font-family:monospace;word-break:break-all;user-select:all;">'
          +   updaterEscape(fullToken)
          + '</div>'
          + '<div style="display:flex;gap:.5rem;flex-wrap:wrap;margin-top:.6rem;">'
          + '<button class="updater-btn updater-btn-secondary" onclick="updaterCopyFreshToken()" '
          + 'style="font-size:.85rem;padding:.45rem .9rem;">' + updaterEscape(updaterT('recovery.token_copy_button')) + '</button>'
          + '<button class="updater-btn" onclick="updaterLoadPanelConfig()" '
          + 'style="font-size:.85rem;padding:.45rem .9rem;">' + updaterEscape(updaterT('recovery.token_dismiss_button')) + '</button>'
          + '</div>';
    });
}

function updaterCopyFreshToken() {
    const el = document.getElementById('panelTokenValueFull');
    if (!el) return;
    const token = el.textContent;
    navigator.clipboard.writeText(token).then(() => {
        const btn = event.target;
        const original = btn.textContent;
        btn.textContent = updaterT('recovery.token_copied');
        setTimeout(() => { btn.textContent = original; }, 1500);
    });
}

function updaterRenderPkgRow(p) {
    const isContao = p.name.startsWith('contao/') || p.name.includes('contao-');
    const nameClass = isContao ? 'updater-pkg-name contao' : 'updater-pkg-name';

    let updateCell = '<span style="color:var(--updater-text-very-soft);">—</span>';
    if (p.has_update && p.latest) {
        const semver = updaterDetectSemverChange(p.current, p.latest);
        const blockedNote = p.is_blocked
            ? ' <span style="color:var(--updater-tag-blocked-fg);font-size:.75rem;font-weight:normal;" title="' + updaterEscape(updaterT('dashboard.packages_blocked_title')) + '">' + updaterEscape(updaterT('dashboard.packages_tag_blocked_short')) + '</span>'
            : '';
        updateCell = '<span class="updater-pkg-arrow">→</span> '
            + '<span class="updater-pkg-newversion semver-' + semver + '">'
            + updaterEscape(p.latest) + '</span>'
            + blockedNote;
    }

    let tags = '';
    if (p.is_blocked) {
        tags += '<span class="updater-pkg-tag updater-pkg-tag-blocked" title="' + updaterEscape(updaterT('dashboard.packages_tag_blocked_title')) + '">' + updaterEscape(updaterT('dashboard.packages_tag_blocked')) + '</span> ';
    } else if (p.has_update) {
        tags += '<span class="updater-pkg-tag updater-pkg-tag-update">' + updaterEscape(updaterT('dashboard.packages_tag_update')) + '</span> ';
    } else if (p.status === 'up-to-date') {
        tags += '<span class="updater-pkg-tag updater-pkg-tag-uptodate">' + updaterEscape(updaterT('dashboard.packages_tag_uptodate')) + '</span> ';
    }
    if (p.abandoned) {
        tags += '<span class="updater-pkg-tag updater-pkg-tag-abandoned">' + updaterEscape(updaterT('dashboard.packages_tag_abandoned')) + '</span> ';
    }

    const desc = p.description
        ? '<div style="color:var(--updater-text-soft);font-size:.8rem;margin-top:.15rem;">'
            + updaterEscape(p.description.length > 100 ? p.description.slice(0,100)+'…' : p.description)
            + '</div>'
        : '';

    return '<tr>'
        + '<td><div class="' + nameClass + '">' + updaterEscape(p.name) + '</div>' + desc + '</td>'
        + '<td><span class="updater-pkg-version">' + updaterEscape(p.current) + '</span></td>'
        + '<td>' + updateCell + '</td>'
        + '<td>' + tags + '</td>'
        + '</tr>';
}

function updaterDetectSemverChange(current, latest) {
    const c = current.split('.');
    const l = latest.split('.');
    if (c[0] !== l[0]) return 'major';
    if (c[1] !== l[1]) return 'minor';
    return 'patch';
}
</script>
{% endblock %}
